# Environment variable profile for running DBT-7 against ColdFront.
# Source this file before running dbt7 commands:
#   source examples/dbt7_coldfront_profile

# Absolute path to the location of the unzipped, patched, and built TPC-DS
# Tools.
export DSHOME="/tmp/DSGen-software-code-4.0.0_final"

export DSQUERY="${DSHOME}/query_templates"
export DSTOOLS="${DSHOME}/tools"

# Location to write flat files generated by dsdgen.
export DS_DATA="/tmp/dbt7data"

# Database name — use the ColdFront service database so DuckDB's internal
# pglocal connection (configured in postgresql.conf) resolves staging tables.
export DBT7DBNAME=coldfront

# PostgreSQL connection (Defaults intended to match ColdFront's Docker Compose
# local-store profile)
export PGHOST=localhost
export PGUSER=coldfront
export PGPASSWORD=coldfront
# export PGPORT=5432  # uncomment if using a non-default port

# --- ColdFront cold-tier configuration ---

# Storage backend: s3 (default), azure, gcs, or aws.
export COLDFRONT_BACKEND=s3

# S3-compatible endpoint (host:port).
# For the Docker Compose local-store profile this is the Docker service name,
# not localhost.
export COLDFRONT_S3_ENDPOINT="seaweedfs:8333"

# Lakekeeper Iceberg REST catalog URL.
export COLDFRONT_LK_ENDPOINT="http://localhost:8181/catalog"

# Iceberg warehouse name (must match the warehouse registered in Lakekeeper).
export COLDFRONT_WAREHOUSE=wh

# Iceberg namespace.
export COLDFRONT_NAMESPACE=default

# S3 access key and secret (used for s3, gcs, and aws backends).
export COLDFRONT_ACCESS_KEY=admin
export COLDFRONT_SECRET_KEY=adminsecret

# Azure connection string — uncomment when COLDFRONT_BACKEND=azure.
#export COLDFRONT_AZURE_CONN="AccountName=...;AccountKey=...;..."

# AWS region — uncomment when COLDFRONT_BACKEND=aws.
#export COLDFRONT_AWS_REGION=us-east-1
