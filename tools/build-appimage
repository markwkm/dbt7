#!/bin/sh

usage()
{
	echo "usage: $(basename "${0}") [-d]"
	echo "  -d  use docker instead of podman"
}

CONTAINER_CMD=""
USE_DOCKER=0

# Custom argument handling for hopefully most portability.
while [ "${#}" -gt 0 ]; do
	case "${1}" in
	(-d)
		USE_DOCKER=1
		;;
	(-h | -\? | --help)
		usage
		exit 0
		;;
	(--* | -*)
		usage
		exit 1
		;;
	(*)
		break
		;;
	esac
	shift
done

if [ ${USE_DOCKER} -eq 1 ]; then
	if ! command -v docker > /dev/null 2>&1; then
		echo "docker is not in your path"
		exit 1
	fi
	CONTAINER_CMD="docker"
elif command -v podman > /dev/null 2>&1; then
	CONTAINER_CMD="podman"
elif command -v docker > /dev/null 2>&1; then
	CONTAINER_CMD="docker"
else
	echo "podman or docker is not in your path"
	exit 1
fi

CONTAINER_DIR=$(readlink -f "$(dirname "$0")")
SRCDIR=$(readlink -f "${CONTAINER_DIR}/..")
CONTAINER_TAG="dbt7-appimage"
TARGET="appimage"

# The version is derived from git at configure time.  A linked worktree
# keeps its git metadata outside the source directory: .git is a file naming
# the directory that holds it.  Mount that directory at the same path it has
# here, so the version the build derives from git is the same one a build
# outside the container derives.  A plain clone keeps everything under the
# source directory, which is already mounted, and adds nothing.
set --
if [ -f "${SRCDIR}/.git" ]; then
	GITDIR="$(sed -n 's/^gitdir: //p' "${SRCDIR}/.git")"
	if [ -d "${GITDIR}" ]; then
		# commondir is relative to the directory holding it, and names the
		# repository the worktree belongs to.
		COMMONDIR="$(cd "${GITDIR}" &&
				cd "$(cat commondir 2> /dev/null || echo .)" &&
				pwd)"
		# Read-write: the worktree's index lives in this directory, and
		# the refresh of that index at configure time has to write.
		set -- -v "${COMMONDIR}:${COMMONDIR}:rw,Z"
	fi
fi

# Use the return code from `$CONTAINER_CMD inspect` to determine if the container
# image needs to be created.
if ! ${CONTAINER_CMD} inspect ${CONTAINER_TAG} > /dev/null 2>&1; then
	DOCKER_FLAG=""
	if [ "${CONTAINER_CMD}" = "docker" ]; then
		DOCKER_FLAG="-d"
	fi
	"${CONTAINER_DIR}/build-appimage-container" ${DOCKER_FLAG} || exit 1
fi

# Build the AppImage inside the container image, which uses an old
# glibc to maximize compatibility across Linux distributions.
${CONTAINER_CMD} run \
		--rm \
		-v "${CONTAINER_DIR}/..:/usr/local/src/dbt7:rw,Z" \
		"$@" \
		--env PKG_CONFIG_PATH="/usr/lib/pkgconfig" \
		-w /usr/local/src/dbt7 \
		$CONTAINER_TAG \
		make DBMS="${DBMS}" "${TARGET}"

# With docker, files are created as root. Fix ownership to match the host user.
# Podman rootless already maps container root to the host user.
if [ "${CONTAINER_CMD}" = "docker" ]; then
	${CONTAINER_CMD} run \
			--rm \
			-v "${CONTAINER_DIR}/..:/usr/local/src/dbt7:rw,Z" \
			-w /usr/local/src/dbt7 \
			${CONTAINER_TAG} \
			chown -R "$(id -u):$(id -g)" build
fi
