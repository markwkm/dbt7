#!/bin/sh

usage()
{
	echo "usage: $(basename "${0}") [-d]"
	echo "  -d  use docker instead of podman"
}

CONTAINER_CMD=""
CONTAINERFILE="appimage/Containerfile"
USE_DOCKER=0

# Custom argument handling for hopefully most portability.
while [ "${#}" -gt 0 ]; do
	case "${1}" in
	(-d)
		USE_DOCKER=1
		;;
	(-h | -\? | --help)
		usage
		exit 0
		;;
	(--* | -*)
		usage
		exit 1
		;;
	(*)
		break
		;;
	esac
	shift
done

if [ ${USE_DOCKER} -eq 1 ]; then
	if ! command -v docker > /dev/null 2>&1; then
		echo "docker is not in your path"
		exit 1
	fi
	CONTAINER_CMD="docker"
elif command -v podman > /dev/null 2>&1; then
	CONTAINER_CMD="podman"
elif command -v docker > /dev/null 2>&1; then
	CONTAINER_CMD="docker"
else
	echo "podman or docker is not in your path"
	exit 1
fi

CONTAINER_DIR=$(readlink -f "$(dirname "$0")")
CONTAINER_TAG="dbt7-appimage"

ARCH="$(uname -m)"

if [ "${ARCH}" = "arm64" ]; then
	ARCH="aarch64"
fi

ISOLATION_FLAG=""
if [ "${CONTAINER_CMD}" = "podman" ]; then
	ISOLATION_FLAG="--isolation=chroot"
fi

# Forward the source overrides for the bundled tools when they are set
# in the environment.  The ARG comments in appimage/Containerfile
# describe them.
set --
if [ -n "${DBTTOOLSREPO:-}" ]; then
	set -- "${@}" --build-arg "DBTTOOLSREPO=${DBTTOOLSREPO}"
fi
if [ -n "${DBTTOOLSREF:-}" ]; then
	set -- "${@}" --build-arg "DBTTOOLSREF=${DBTTOOLSREF}"
fi
if [ -n "${TSTOOLSREPO:-}" ]; then
	set -- "${@}" --build-arg "TSTOOLSREPO=${TSTOOLSREPO}"
fi
if [ -n "${TSTOOLSREF:-}" ]; then
	set -- "${@}" --build-arg "TSTOOLSREF=${TSTOOLSREF}"
fi

cd "${CONTAINER_DIR}/.." && \
		${CONTAINER_CMD} build \
				${ISOLATION_FLAG} \
				--build-arg ARCH="${ARCH}" \
				"${@}" \
				-t $CONTAINER_TAG \
				-f ${CONTAINERFILE} \
				.
