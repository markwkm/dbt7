#!/bin/sh

# Run a small DBT-7 test using the container image against an external
# PostgreSQL instance.  Set PGHOST (and optionally PGPORT) to point the
# test at the database.  Results are saved under ./results.

usage()
{
	echo "usage: $0 [DBMS [SCALE]]"
}

if ! which docker > /dev/null 2>&1; then
	echo "docker not in path"
	exit 1
fi

if [ $# -lt 1 ]; then
	usage
	exit 1
fi

DBMS=$1

SCALE=1
if [ $# -gt 1 ]; then
	SCALE=$2
fi

if [ "${PGHOST}" = "" ]; then
	echo "set PGHOST (and optionally PGPORT) to the database to test"
	exit 1
fi

TOOLSDIR=$(dirname "${0}")

# Use the return code from `docker inspect` to determine if the container
# image needs to be created.
if ! docker inspect dbt7 > /dev/null 2>&1; then
	"${TOOLSDIR}/build-container" || exit 1
fi

RESULTSDIR="$(pwd)/results"
mkdir -p "${RESULTSDIR}"

if ! docker run --rm \
		--network host \
		-e PGHOST \
		-e PGPORT \
		--user "$(id -u):$(id -g)" \
		-v "${RESULTSDIR}:/results" \
		dbt7 run --scale-factor="${SCALE}" "${DBMS}" \
		"/results/$(date +%Y%m%d-%H%M%S)"; then
	usage
	exit 1
fi
