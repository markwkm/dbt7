#!/bin/sh

# Build a container image with the DBT-7 kit installed, using the
# Containerfile at the top of the repository.

if ! which docker > /dev/null 2>&1; then
	echo "docker not in path"
	exit 1
fi

TOPDIR="$(dirname "${0}")/.."

# Forward the source overrides for the bundled tools when they are set
# in the environment.  The ARG comments in Containerfile describe them.
set --
if [ -n "${DBTTOOLSREPO:-}" ]; then
	set -- "${@}" --build-arg "DBTTOOLSREPO=${DBTTOOLSREPO}"
fi
if [ -n "${DBTTOOLSREF:-}" ]; then
	set -- "${@}" --build-arg "DBTTOOLSREF=${DBTTOOLSREF}"
fi
if [ -n "${TSTOOLSREPO:-}" ]; then
	set -- "${@}" --build-arg "TSTOOLSREPO=${TSTOOLSREPO}"
fi
if [ -n "${TSTOOLSREF:-}" ]; then
	set -- "${@}" --build-arg "TSTOOLSREF=${TSTOOLSREF}"
fi

docker build "${@}" -t dbt7 -f "${TOPDIR}/Containerfile" "${TOPDIR}"
