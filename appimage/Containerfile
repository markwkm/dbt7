# Build an environment for creating an AppImage.

# Use a distro with an old libc to maximize support on as many linux distros as
# possible for x86_64 and aarch64.
FROM debian:10

ARG ARCH

# Fail fast when ARCH is not provided; downloads below depend on it.
RUN test -n "${ARCH}" || \
    { echo "ARCH build-arg is required (e.g. x86_64 or aarch64)"; exit 1; }

ENV DEBIAN_FRONTEND=noninteractive

RUN echo "deb http://archive.debian.org/debian buster main" > /etc/apt/sources.list && \
    echo "deb http://archive.debian.org/debian-security buster/updates main" >> /etc/apt/sources.list && \
    echo "deb http://archive.debian.org/debian buster-updates main" >> /etc/apt/sources.list

RUN apt-get -qq -y update && \
    apt-get -qq -y dist-upgrade && \
    apt-get -qq -y install bison \
                   bzip2 \
                   ca-certificates \
                   curl \
                   file \
                   flex \
                   gcc \
                   git \
                   gnupg2 \
                   libcairo2-dev \
                   libffi-dev \
                   libfontconfig1-dev \
                   libfribidi-dev \
                   libgraphite2-dev \
                   libharfbuzz-dev \
                   libpango1.0-dev \
                   libssl-dev \
                   pkg-config \
                   make \
                   patch \
                   perl \
                   unzip \
                   wget \
                   xz-utils \
                   zlib1g-dev && \
    apt-get -qq -y clean && \
    apt-get -qq -y autoclean

# Collect the copyright files of the Debian-packaged components that
# are bundled into the AppImage, named <component>-<version>.
RUN set -e; \
    for pkglic in cairo:libcairo2 \
                  fontconfig:libfontconfig1 \
                  freetype:libfreetype6 \
                  fribidi:libfribidi0 \
                  graphite2:libgraphite2-3 \
                  harfbuzz:libharfbuzz0b \
                  libpng:libpng16-16 \
                  libx11:libx11-6 \
                  libxau:libxau6 \
                  libbsd:libbsd0 \
                  libssl1.1:libssl1.1 \
                  libxcb:libxcb-shm0 \
                  libxext:libxext6 \
                  libxdmcp:libxdmcp6 \
                  libxrender:libxrender1 \
                  pixman:libpixman-1-0 \
                  perl:perl; do \
        name="${pkglic%%:*}"; \
        pkg="${pkglic#*:}"; \
        version="$(dpkg-query -W -f='${Version}' "${pkg}")"; \
        mkdir -p "/usr/local/share/licenses/${name}-${version}"; \
        cp -p "/usr/share/doc/${pkg}/copyright" \
           "/usr/local/share/licenses/${name}-${version}/"; \
    done

ARG PYTHONMVER="3.11"
ARG PYTHONVER="${PYTHONMVER}.1"
ARG PYTHONSHA256="baed518e26b337d4d8105679caf68c5c32630d702614fc174e98cb95c46bdfa4"
RUN curl -o /tmp/Python-${PYTHONVER}.tgz -SsL \
         https://www.python.org/ftp/python/${PYTHONVER}/Python-${PYTHONVER}.tgz && \
    echo "${PYTHONSHA256}  /tmp/Python-${PYTHONVER}.tgz" | sha256sum -c - && \
    tar -C /usr/local/src -xf /tmp/Python-${PYTHONVER}.tgz && \
    cd /usr/local/src/Python-${PYTHONVER} && \
    ./configure --silent --prefix=/usr/local \
                --with-openssl-rpath=/usr/local/lib && \
    make -s -j$(nproc) && \
    make -s install && \
    mkdir -p /usr/local/share/licenses/python-${PYTHONVER} && \
    cp -p LICENSE /usr/local/share/licenses/python-${PYTHONVER}/ && \
    cd / && \
    rm -rf /usr/local/src/Python-${PYTHONVER} /tmp/Python-${PYTHONVER}.tgz

ARG DOCUTILSVER="0.21.2"
RUN /usr/local/bin/pip3 install docutils==${DOCUTILSVER}
RUN mkdir -p /usr/local/share/licenses/docutils-${DOCUTILSVER} && \
    cp -p /usr/local/lib/python${PYTHONMVER}/site-packages/docutils-${DOCUTILSVER}.dist-info/COPYING.txt \
       /usr/local/share/licenses/docutils-${DOCUTILSVER}/

ARG PGVER="10.23"
ARG PGSHA256="94a4b2528372458e5662c18d406629266667c437198160a18cdfd2c4a4d6eee9"
RUN wget -O /tmp/postgresql-${PGVER}.tar.bz2 -q \
         https://ftp.postgresql.org/pub/source/v${PGVER}/postgresql-${PGVER}.tar.bz2 && \
    echo "${PGSHA256}  /tmp/postgresql-${PGVER}.tar.bz2" | sha256sum -c - && \
    tar -C /usr/local/src -xf /tmp/postgresql-${PGVER}.tar.bz2 && \
    cd /usr/local/src/postgresql-${PGVER} && \
    ./configure --silent --without-ldap --without-readline --without-zlib \
                --without-gssapi --with-openssl --prefix=/usr && \
    make -s -j $(nproc) install && \
    ldconfig && \
    mkdir -p /usr/local/share/licenses/postgresql-${PGVER} && \
    cp -p COPYRIGHT /usr/local/share/licenses/postgresql-${PGVER}/ && \
    cd / && \
    rm -rf /usr/local/src/postgresql-${PGVER} /tmp/postgresql-${PGVER}.tar.bz2

ARG CMAKEVER="3.21.0"
ARG CMAKESHA256_X86_64="d54ef6909f519740bc85cec07ff54574cd1e061f9f17357d9ace69f61c6291ce"
ARG CMAKESHA256_AARCH64="b1e46825bf370f45f8f47c3a497b1122759ee41fbd60187e525f517a4b0934eb"
RUN curl -o /tmp/cmake-${CMAKEVER}-linux-${ARCH}.tar.gz -SsL \
         https://github.com/Kitware/CMake/releases/download/v${CMAKEVER}/cmake-${CMAKEVER}-linux-${ARCH}.tar.gz && \
    case "${ARCH}" in \
    (x86_64) CMAKESHA256="${CMAKESHA256_X86_64}";; \
    (aarch64) CMAKESHA256="${CMAKESHA256_AARCH64}";; \
    esac && \
    echo "${CMAKESHA256}  /tmp/cmake-${CMAKEVER}-linux-${ARCH}.tar.gz" | \
        sha256sum -c - && \
    tar -C /usr --strip-components=1 \
        -xf /tmp/cmake-${CMAKEVER}-linux-${ARCH}.tar.gz && \
    rm -f /tmp/cmake-${CMAKEVER}-linux-${ARCH}.tar.gz

# Install DBT Tools

ARG DBTTOOLSVER="0.5.1"
ARG DBTTOOLSSHA256="f2f5395c1a421dabc7f1bd4f509cde17645cb80ed9375ae9467292ffd06e6575"
RUN curl -o /tmp/v${DBTTOOLSVER}.tar.gz -SsL \
         https://github.com/osdldbt/dbttools/archive/refs/tags/v${DBTTOOLSVER}.tar.gz && \
    echo "${DBTTOOLSSHA256}  /tmp/v${DBTTOOLSVER}.tar.gz" | sha256sum -c - && \
    tar -C /usr/local/src -xf /tmp/v${DBTTOOLSVER}.tar.gz && \
    cd /usr/local/src/dbttools-${DBTTOOLSVER} && \
    cmake -H. -Bbuild/release -DCMAKE_INSTALL_PREFIX=/usr && \
    (cd build/release && make -s install) && \
    mkdir -p /usr/local/share/licenses/dbttools-${DBTTOOLSVER} && \
    cp -p LICENSE /usr/local/share/licenses/dbttools-${DBTTOOLSVER}/ && \
    cd / && \
    rm -rf /usr/local/src/dbttools-${DBTTOOLSVER} /tmp/v${DBTTOOLSVER}.tar.gz

ARG SQLITE3VER=3410200
ARG SQLITE3SHA256="e98c100dd1da4e30fa460761dab7c0b91a50b785e167f8c57acc46514fae9499"
RUN wget -O /tmp/sqlite-autoconf-${SQLITE3VER}.tar.gz -q \
         https://www.sqlite.org/2023/sqlite-autoconf-${SQLITE3VER}.tar.gz && \
    echo "${SQLITE3SHA256}  /tmp/sqlite-autoconf-${SQLITE3VER}.tar.gz" | \
        sha256sum -c - && \
    tar -C /usr/local/src -xf /tmp/sqlite-autoconf-${SQLITE3VER}.tar.gz && \
    cd /usr/local/src/sqlite-autoconf-${SQLITE3VER} && \
    ./configure --quiet --silent --prefix=/usr/local && \
    make -s -j $(nproc) install && \
    mkdir -p /usr/local/share/licenses/sqlite-autoconf-${SQLITE3VER} && \
    cp -p tea/license.terms \
       /usr/local/share/licenses/sqlite-autoconf-${SQLITE3VER}/ && \
    cd / && \
    rm -rf /usr/local/src/sqlite-autoconf-${SQLITE3VER} \
       /tmp/sqlite-autoconf-${SQLITE3VER}.tar.gz

ARG PANGOVER="1.42"
ARG PANGOMINORVER="4"
ARG PANGOSHA256="1d2b74cd63e8bd41961f2f8d952355aa0f9be6002b52c8aa7699d9f5da597c9d"
RUN curl -o /tmp/pango-${PANGOVER}.${PANGOMINORVER}.tar.xz -SsL \
         https://download.gnome.org/sources/pango/${PANGOVER}/pango-${PANGOVER}.${PANGOMINORVER}.tar.xz && \
    echo "${PANGOSHA256}  /tmp/pango-${PANGOVER}.${PANGOMINORVER}.tar.xz" | \
        sha256sum -c - && \
    tar -C /usr/local/src -xf /tmp/pango-${PANGOVER}.${PANGOMINORVER}.tar.xz && \
    cd /usr/local/src/pango-${PANGOVER}.${PANGOMINORVER} && \
    ./configure --quiet --silent --prefix=/usr/local && \
    make -s -j $(nproc) install && \
    ldconfig && \
    mkdir -p /usr/local/share/licenses/pango-${PANGOVER}.${PANGOMINORVER} && \
    cp -p COPYING \
       /usr/local/share/licenses/pango-${PANGOVER}.${PANGOMINORVER}/ && \
    cd / && \
    rm -rf /usr/local/src/pango-${PANGOVER}.${PANGOMINORVER} \
       /tmp/pango-${PANGOVER}.${PANGOMINORVER}.tar.xz

ARG GNUPLOTVER="5.4.6"
ARG GNUPLOTSHA256="02fc27918200ed64d8f0c3b84fe81b95b59cd47ad99f270939ae497c19f27419"
RUN wget -O /tmp/gnuplot-${GNUPLOTVER}.tar.gz -q \
         https://sourceforge.net/projects/gnuplot/files/gnuplot/5.4.6/gnuplot-5.4.6.tar.gz/download && \
    echo "${GNUPLOTSHA256}  /tmp/gnuplot-${GNUPLOTVER}.tar.gz" | \
        sha256sum -c - && \
    tar -C /usr/local/src -xf /tmp/gnuplot-${GNUPLOTVER}.tar.gz && \
    cd /usr/local/src/gnuplot-${GNUPLOTVER} && \
    ./configure -q --prefix=/usr/local && \
    make -s -j$(nproc) install && \
    mkdir -p /usr/local/share/licenses/gnuplot-${GNUPLOTVER} && \
    cp -p Copyright README \
       /usr/local/share/licenses/gnuplot-${GNUPLOTVER}/ && \
    cd / && \
    rm -rf /usr/local/src/gnuplot-${GNUPLOTVER} \
       /tmp/gnuplot-${GNUPLOTVER}.tar.gz

# Install the Rust toolchain only long enough to build spar from the
# Touchstone Tools; nothing needs it after the image is built.
ARG RUSTVER="1.97.1"
ARG TSTOOLSVER="0.10.4"
ARG TSTOOLSSHA256="19b5f9dcdc5b7cf4c5be4416599b538e59bb62bc5973c21d27590ef377bde298"
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
         -o /tmp/sh.rustup.sh && \
    sh /tmp/sh.rustup.sh -y --default-toolchain ${RUSTVER} && \
    curl -o /tmp/touchstone-tools-v${TSTOOLSVER}.tar.gz -SsL \
         https://gitlab.com/touchstone/touchstone-tools/-/archive/v${TSTOOLSVER}/touchstone-tools-v${TSTOOLSVER}.tar.gz && \
    echo "${TSTOOLSSHA256}  /tmp/touchstone-tools-v${TSTOOLSVER}.tar.gz" | \
        sha256sum -c - && \
    mkdir -p /usr/local/src/touchstone-tools-v${TSTOOLSVER} && \
    tar -C /usr/local/src/touchstone-tools-v${TSTOOLSVER} \
        --strip-components=1 \
        -xf /tmp/touchstone-tools-v${TSTOOLSVER}.tar.gz && \
    cd /usr/local/src/touchstone-tools-v${TSTOOLSVER} && \
    cmake -H. -Bbuild/release -DCMAKE_INSTALL_PREFIX=/usr && \
    (cd build/release && make -s install) && \
    (cd spar && ${HOME}/.cargo/bin/cargo install --root /usr/local --path .) && \
    mkdir -p /usr/local/share/licenses/touchstone-tools-v${TSTOOLSVER} && \
    cp -p COPYRIGHT \
       /usr/local/share/licenses/touchstone-tools-v${TSTOOLSVER}/ && \
    cd / && \
    rm -rf /usr/local/src/touchstone-tools-v${TSTOOLSVER} \
       /tmp/touchstone-tools-v${TSTOOLSVER}.tar.gz \
       /tmp/sh.rustup.sh "${HOME}/.rustup" "${HOME}/.cargo"

WORKDIR /usr/local
ARG APPIMAGETOOLVER="1.9.1"
ARG APPIMAGETOOLSHA256_X86_64="ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0"
ARG APPIMAGETOOLSHA256_AARCH64="f0837e7448a0c1e4e650a93bb3e85802546e60654ef287576f46c71c126a9158"
RUN curl -SsOL \
         https://github.com/AppImage/appimagetool/releases/download/${APPIMAGETOOLVER}/appimagetool-${ARCH}.AppImage && \
    case "${ARCH}" in \
    (x86_64) APPIMAGETOOLSHA256="${APPIMAGETOOLSHA256_X86_64}";; \
    (aarch64) APPIMAGETOOLSHA256="${APPIMAGETOOLSHA256_AARCH64}";; \
    esac && \
    echo "${APPIMAGETOOLSHA256}  appimagetool-${ARCH}.AppImage" | \
        sha256sum -c - && \
    chmod +x appimagetool-${ARCH}.AppImage && \
    ./appimagetool-${ARCH}.AppImage --appimage-extract
