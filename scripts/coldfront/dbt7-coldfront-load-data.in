#!/bin/sh
@SHELLOPTIONS@
#
# This file is released under the terms of the Artistic License.
# Please see the file LICENSE, included in this package, for details.
#
# Copyright The DBT-7 Authors

usage()
{
	cat << EOF
$(basename "${0}") is the Database Test 7 (DBT-7) ColdFront data loader

Usage:
  $(basename "${0}") [OPTION]

Options:
  -s SCALE_FACTOR, --scale-factor=SCALE_FACTOR
                   set the scale factor
  --parallel CHUNKS
                   parallelize the staging load into CHUNKS parts
  -?, --help       show this help, then exit
EOF
}

CHUNKS=""
CPUS=1
PSQL="psql -v ON_ERROR_STOP=1 -X -d ${DBT7DBNAME}"

if [ -z "${DSTOOLS}" ]; then
	echo "DSTOOLS env var is not set"
	exit 1
fi
if [ ! -d "${DSTOOLS}" ]; then
	echo "DSTOOLS dir does not exist: ${DSTOOLS}"
	exit 2
fi

# Load one table: parallel COPY into the staging table, then a single
# INSERT ... SELECT into the ColdFront Iceberg view, then truncate staging.
# COPY is not supported directly on ColdFront views; the staging table is a
# regular PG table that serves as a transfer buffer.
load_table()
{
	TABLE=$1

	echo "loading table: ${TABLE}"

	T="public.staging_${TABLE}"
	if ! ${PSQL} -c "ALTER TABLE ${T} \
SET (autovacuum_enabled = false, toast.autovacuum_enabled = false);"; then
		echo "ERROR: could not disable autovacuum on ${T}"
		exit 1
	fi

	JOBS=""
	FILENAME="${DS_DATA}/${TABLE}.dat"
	if [ -f "${FILENAME}" ]; then
		# Unchunked data generation creates a single file per table;
		# split it into a stream per processor.
		TOTAL_ROWS="$(wc -l "${FILENAME}" | cut -d " " -f 1)"
		if [ "${TOTAL_ROWS}" -eq 0 ]; then
			# Nothing to load, but avoid dividing by zero below.
			ROWS_PER_COMMIT=1
		elif [ "${TOTAL_ROWS}" -lt "${CPUS}" ]; then
			ROWS_PER_COMMIT=${TOTAL_ROWS}
		else
			ROWS_PER_COMMIT=$(( TOTAL_ROWS / CPUS ))
		fi
		N=$(( (TOTAL_ROWS + ROWS_PER_COMMIT - 1) / ROWS_PER_COMMIT ))

		for I in $(seq 1 "${N}"); do
			PROG="split -n l/${I}/${N} ${FILENAME}"
			${PSQL} << __EOF__ &
\COPY ${T} FROM PROGRAM '${PROG}' WITH (DELIMITER '|', NULL '');
__EOF__
			JOBS="${JOBS} ${!}"
		done
	else
		# Chunked data generation creates a file per dsdgen child
		# (pattern: table_child_chunks.dat).  Tables too small for
		# dsdgen to chunk are emitted in their entirety by the first
		# child only, so load whatever files exist, one process per
		# file.  The leading [0-9] keeps a table from matching the
		# chunks of another table it is a name prefix of, e.g. store
		# and store_sales.
		N=0
		for FILENAME in "${DS_DATA}/${TABLE}"_[0-9]*_[0-9]*.dat; do
			if [ ! -f "${FILENAME}" ]; then
				continue
			fi
			N=$(( N + 1 ))
			${PSQL} << __EOF__ &
\COPY ${T} FROM '${FILENAME}' WITH (DELIMITER '|', NULL '');
__EOF__
			JOBS="${JOBS} ${!}"
		done
		if [ "${N}" -eq 0 ]; then
			echo "ERROR: no data files for table ${TABLE} in" \
				"${DS_DATA}"
			exit 1
		fi
	fi

	RC=0
	for JOB in ${JOBS}; do
		wait "${JOB}" || RC=1
	done
	if [ "${RC}" -ne 0 ]; then
		echo "ERROR: could not load staging table ${T}"
		exit 1
	fi

	if ! ${PSQL} -c "INSERT INTO public.${TABLE} SELECT * FROM ${T};"; then
		echo "ERROR: could not load table ${TABLE} from ${T}"
		exit 1
	fi
	if ! ${PSQL} -c "TRUNCATE ${T};"; then
		echo "ERROR: could not truncate ${T}"
		exit 1
	fi
	if ! ${PSQL} -c "ALTER TABLE ${T} \
SET (autovacuum_enabled = true, toast.autovacuum_enabled = true);"; then
		echo "ERROR: could not re-enable autovacuum on ${T}"
		exit 1
	fi
}

# Custom argument handling for hopefully most portability.
while [ "${#}" -gt 0 ] ; do
	case "${1}" in
	(-s | --scale-factor)
		shift
		SCALE="${1}"
		;;
	(--parallel)
		shift
		CHUNKS="${1}"
		;;
	(--parallel=?*)
		CHUNKS="${1#*--parallel=}"
		;;
	(--scale-factor=?*)
		SCALE="${1#*--scale-factor=}"
		;;
	(--tablespaces)
		# NOOP
		;;
	(-U)
		# NOOP
		;;
	(-\? | --help)
		usage
		exit 0
		;;
	(--* | -*)
		echo "$(basename "${0}"): invalid option -- '${1}'"
		echo "try \"$(basename "${0}") --help\" for more information."
		exit 1
		;;
	(*)
		break
		;;
	esac
	shift
done

if [ -z "${DBT7DBNAME}" ]; then
	echo "Error: DBT7DBNAME environment variable not defined"
	exit 1
fi

if [ -z "${SCALE}" ]; then
	echo "SCALE must be set with -s"
	exit 3
fi

if [ "${CHUNKS}" = "" ]; then
	if command -v nproc > /dev/null 2>&1; then
		CPUS=$(nproc)
		echo "detected ${CPUS} logical processors for parallel loading"
	else
		echo "could not detect number of processors, parallelizing for ${CPUS}"
	fi
else
	CPUS=${CHUNKS}
fi

dbt7-coldfront-time-statistics -s -n TABLE
for T in store_sales store_returns catalog_sales catalog_returns web_sales \
		web_returns inventory store call_center catalog_page web_site web_page \
		warehouse customer customer_address customer_demographics date_dim \
		household_demographics item income_band promotion reason ship_mode \
		time_dim; do
	load_table ${T}
done
dbt7-coldfront-time-statistics -e -n TABLE

dbt7-coldfront-time-statistics -s -n INDEX
dbt7-coldfront-create-indexes
dbt7-coldfront-time-statistics -e -n INDEX
