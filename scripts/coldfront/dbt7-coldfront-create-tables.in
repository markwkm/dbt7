#!/bin/sh
@SHELLOPTIONS@
#
# This file is released under the terms of the Artistic License.
# Please see the file LICENSE, included in this package, for details.
#
# Copyright The DBT-7 Authors

# Custom argument handling for hopefully most portability.
while [ "${#}" -gt 0 ]; do
	case "${1}" in
	(--tablespaces)
		# NOOP
		;;
	esac
	shift
done

if [ -z "${DBT7DBNAME}" ]; then
	echo "Error: DBT7DBNAME environment variable not defined"
	exit 1
fi

PSQL="psql -v ON_ERROR_STOP=1 -X -d ${DBT7DBNAME}"

# Create each TPC-DS primary table as a ColdFront Iceberg (decoupled) table,
# and a matching regular PG table (staging_<name> in public) for bulk COPY.
# Staging tables live in public so that DuckDB's pglocal connection can find
# them when ColdFront rewrites INSERT ... SELECT into an Iceberg write.

${PSQL} << '__EOF__' || exit 1

SELECT coldfront.create_iceberg_table('public', 'store_sales', '[
  {"name":"ss_sold_date_sk","type":"bigint"},
  {"name":"ss_sold_time_sk","type":"bigint"},
  {"name":"ss_item_sk","type":"bigint"},
  {"name":"ss_customer_sk","type":"bigint"},
  {"name":"ss_cdemo_sk","type":"bigint"},
  {"name":"ss_hdemo_sk","type":"bigint"},
  {"name":"ss_addr_sk","type":"bigint"},
  {"name":"ss_store_sk","type":"bigint"},
  {"name":"ss_promo_sk","type":"bigint"},
  {"name":"ss_ticket_number","type":"bigint"},
  {"name":"ss_quantity","type":"integer"},
  {"name":"ss_wholesale_cost","type":"double precision"},
  {"name":"ss_list_price","type":"double precision"},
  {"name":"ss_sales_price","type":"double precision"},
  {"name":"ss_ext_discount_amt","type":"double precision"},
  {"name":"ss_ext_sales_price","type":"double precision"},
  {"name":"ss_ext_wholesale_cost","type":"double precision"},
  {"name":"ss_ext_list_price","type":"double precision"},
  {"name":"ss_ext_tax","type":"double precision"},
  {"name":"ss_coupon_amt","type":"double precision"},
  {"name":"ss_net_paid","type":"double precision"},
  {"name":"ss_net_paid_inc_tax","type":"double precision"},
  {"name":"ss_net_profit","type":"double precision"}
]'::jsonb);

CREATE TABLE public.staging_store_sales (
    ss_sold_date_sk BIGINT,
    ss_sold_time_sk BIGINT,
    ss_item_sk BIGINT,
    ss_customer_sk BIGINT,
    ss_cdemo_sk BIGINT,
    ss_hdemo_sk BIGINT,
    ss_addr_sk BIGINT,
    ss_store_sk BIGINT,
    ss_promo_sk BIGINT,
    ss_ticket_number BIGINT,
    ss_quantity INTEGER,
    ss_wholesale_cost DOUBLE PRECISION,
    ss_list_price DOUBLE PRECISION,
    ss_sales_price DOUBLE PRECISION,
    ss_ext_discount_amt DOUBLE PRECISION,
    ss_ext_sales_price DOUBLE PRECISION,
    ss_ext_wholesale_cost DOUBLE PRECISION,
    ss_ext_list_price DOUBLE PRECISION,
    ss_ext_tax DOUBLE PRECISION,
    ss_coupon_amt DOUBLE PRECISION,
    ss_net_paid DOUBLE PRECISION,
    ss_net_paid_inc_tax DOUBLE PRECISION,
    ss_net_profit DOUBLE PRECISION
);

SELECT coldfront.create_iceberg_table('public', 'store_returns', '[
  {"name":"sr_returned_date_sk","type":"bigint"},
