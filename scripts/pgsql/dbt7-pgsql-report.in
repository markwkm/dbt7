# Please see the file LICENSE, included in this package, for details.
#
# Copyright The DBT-7 Authors

usage()
{
	cat << EOF
$(basename "${0}") is the Database Test 7 (DBT-7) PostgreSQL report generator

Usage:
  $(basename "${0}") [OPTION] DIRECTORY

Options:
  --skip-database-plotting
                   don't plot database statistics
  -i PATH          results directory
  -V, --version    output version information, then exit
  -?, --help       show this help, then exit

DIRECTORY is the path to DBT-7 results.

@HOMEPAGE@
EOF
}

create_pid_page()
{
	LABEL=$1
	PID=$2
	DESC=$3

	SUBDIR="${PIDSTATDIR}/report/${LABEL}/${PID}"
	mkdir -p "${SUBDIR}"

	cat > "${SUBDIR}/index.rst" << __EOF__
================================================================================
Database Test 7 pidstat $LABEL Charts (PID $PID)
================================================================================

$DESC

$(show_images "${PID}")
__EOF__
}

list_pids()
{
	PATTERN=$1

	# /proc/<pid>/cmdline (as captured in the index file) separates
	# arguments with NUL bytes rather than spaces. Turn those into
	# spaces here, on the raw byte stream, before any line of it is
	# captured into a shell variable ("read"/"$()" both silently drop
	# embedded NULs, which would otherwise run multi-word commands
	# together, e.g. "postgres-D/var/lib/pgsql/18/data").
	tr '\0' ' ' < "${PIDSTATDIR}/${PIDPREFIX}-index.txt" | \
			grep "${PATTERN}"
}

pid_desc()
{
	LINE=$1

	echo "${LINE}" | cut -d " " -f 2- | \
			sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
					-e 's/[[:space:]]\{2,\}/ /g'
}

create_pages_for_lines()
{
	LABEL=$1
	# stdin: pidstat/spar index lines ("PID COMMAND...") to build pages
	# for.

	OUTDIR="${PIDSTATDIR}/report/${LABEL}"
	mkdir -p "${OUTDIR}"

	LINES=$(cat)

	# Every process gets its own chart page, since combining, say,
	# three "io worker" PIDs onto a single page makes each individual
	# process' charts hard to read.
	echo "${LINES}" | while IFS= read -r LINE; do
		[ -z "${LINE}" ] && continue
		PID=$(echo "${LINE}" | cut -d " " -f 1)
		create_pid_page "${LABEL}" "${PID}" "$(pid_desc "${LINE}")"
	done

	cat > "${OUTDIR}/index.rst" << __EOF__
================================================================================
Database Test 7 pidstat $LABEL Charts
================================================================================

$(echo "${LINES}" | while IFS= read -r LINE; do
	[ -z "${LINE}" ] && continue
	PID=$(echo "${LINE}" | cut -d " " -f 1)
	printf "* \`PID %s: %s <%s/>\`__\n\n" "${PID}" "$(pid_desc "${LINE}")" \
			"${PID}"
done)
__EOF__
}

links_index_metrics()
{
	NAME=$1

	INDEXMETRICS=$( (cd "${INDIR}/${NAME}/dbstat/index" && \
			find . -name "*.png") | sed -e "s/.\/pgsql-*.*.*-//" | \
			sed -e "s/.png$//" | sort | uniq)

	for METRIC in $INDEXMETRICS; do
		printf "\`%s <%s/dbstat/index-stat/i_%s/>\`__ " \
				"${METRIC}" "${NAME}" "${METRIC}"
	done
}

links_indexes()
{
	NAME=$1

	INDEXFILE="${INDIR}/${NAME}/dbstat/index-list.txt"
	if [ -f "${INDEXFILE}" ]; then
		grep ^public\. "${INDEXFILE}" | \
				grep -v "\.pg_catalog\." | while IFS= read -r INDEX; do
			printf "\`%s <%s/dbstat/index/%s/>\`__ " "${INDEX}" "${NAME}" \
					"${INDEX}"
		done
	fi
}

links_table_metrics()
{
	NAME=$1

	TABLEMETRICS=$( (cd "${INDIR}/${NAME}/dbstat/table" && \
			find . -name "*.png") | sed -e "s/^.\/pgsql-*.*-//" | \
			sed -e "s/.png$//" | sort | uniq)

	for METRIC in $TABLEMETRICS; do
		printf "\`%s <%s/dbstat/table-stat/t_%s/>\`__ " \
				"${METRIC}" "${NAME}" "${METRIC}"
	done
}

links_tables()
{
	NAME=$1

	TABLEFILE="${INDIR}/${NAME}/dbstat/table-list.txt"
	if [ -f "${TABLEFILE}" ]; then
		grep ^public\. "${TABLEFILE}" | \
				while IFS= read -r TABLE; do
			printf "\`%s <%s/dbstat/table/%s/>\`__ " \
					"${TABLE}" "${NAME}" "${TABLE}"
		done
	fi
}

version_supported()
{
	MINVER=$1
	MAXVER=$2

	# Unknown server version: don't filter by version, rely solely on
	# whether the process is actually present (checked by the caller).
	if [ -z "${PGVERNUM}" ]; then
		return 0
	fi
	if [ -n "${MINVER}" ] && [ "${PGVERNUM}" -lt "${MINVER}" ]; then
		return 1
	fi
	if [ -n "${MAXVER}" ] && [ "${PGVERNUM}" -gt "${MAXVER}" ]; then
		return 1
	fi
	return 0
}

list_processes()
{
	# Tracks which PIDs the known patterns below have already claimed,
	# so the catch-all pass at the end doesn't duplicate them. A file
	# is used instead of a variable because the while loop below reads
	# from a pipe and therefore runs in a subshell under POSIX sh.
	CLAIMEDFILE=$(mktemp)

	# LABEL:MINVER:MAXVER:PATTERN entries. LABEL names the report
	# page/link. MINVER/MAXVER (either may be blank) bound the major
	# server versions the process type can exist in, taken from
	# PGVERNUM. PATTERN is matched (via list_pids) against the pidstat/
	# spar index line. A page/link is only produced when the version
	# allows it AND it's actually present in this run, so
	# renamed/added/removed PostgreSQL background processes are
	# handled without further code changes.
	printf '%s\n' \
			"autovacuum:::autovacuum launcher" \
			"autovacuum-worker:::autovacuum worker" \
			"bgwriter:::background writer" \
			"checkpointer:::checkpointer" \
			"logger:::postgres: logger" \
			"logical:10::logical replication launcher" \
			"logical-worker:10::logical replication worker" \
			"archiver:::postgres: archiver" \
			"startup:::postgres: startup" \
			"walwriter:::walwriter" \
			"walsender:::wal sender" \
			"walreceiver:::wal receiver" \
			"walsummarizer:17::wal summarizer" \
			"ioworker:18::io worker" \
			"parallel-worker:::parallel worker" \
			"statscollector::14:stats collector" \
			"backend:::postgres: [^ ]* ${DBT7DBNAME:-dbt7} " | \
	while IFS=: read -r LABEL MINVER MAXVER PATTERN; do
		if ! version_supported "${MINVER}" "${MAXVER}"; then
			continue
		fi
		LINES=$(list_pids "${PATTERN}")
		if [ -n "${LINES}" ]; then
			echo "${LINES}" | create_pages_for_lines "${LABEL}"
			echo "${LINES}" | cut -d " " -f 1 >> "${CLAIMEDFILE}"
			printf " \`%s <%s/sysstat/report/%s/>\`__" "${LABEL}" \
					"${DIRECTORY}" "${LABEL}"
		fi
	done

	# Catch-all: any PostgreSQL process not claimed above, e.g. a
	# backend connected to a database other than DBT7DBNAME, or a
	# background worker type this script doesn't know by name yet.
	OTHERLINES=$(list_pids "postgres" | while IFS= read -r LINE; do
		PID=$(echo "${LINE}" | cut -d " " -f 1)
		if ! grep -qxF "${PID}" "${CLAIMEDFILE}" 2> /dev/null; then
			echo "${LINE}"
		fi
	done)
	if [ -n "${OTHERLINES}" ]; then
		echo "${OTHERLINES}" | create_pages_for_lines "other"
		printf " \`%s <%s/sysstat/report/%s/>\`__" "other" \
				"${DIRECTORY}" "other"
	fi

	rm -f "${CLAIMEDFILE}"
	echo ""
}

summarize()
{
	TITLE=$1
	DIRECTORY=$2

	PIDSTATDIR="${INDIR}/${DIRECTORY}/sysstat"

	DBSTATDIR="${INDIR}/${DIRECTORY}/dbstat"
	if [ ! -d "${DBSTATDIR}" ]; then
		return
	fi

	# Read this phase's own readme file so the set of PostgreSQL
	# background processes checked for matches the server version that
	# actually produced this phase's results (e.g. io workers only
	# exist on PG 18+, stats collector only on PG 14 and earlier).
	PGVERNUM=""
	README="${DBSTATDIR}/readme-pgsql.txt"
	if [ -f "${README}" ]; then
		PGVERNUM=$(sed -n \
				's/^PostgreSQL \([0-9][0-9]*\).*/\1/p' "${README}" | \
				head -n 1)
	fi

	# Create additional HTML pages for the database charts.

	if which dbt-pgsql-generate-db-report > /dev/null 2>&1; then
		dbt-pgsql-generate-db-report -t "Database Test 7" \
				-d "${DBT7DBNAME:-dbt7}" -i "${DBSTATDIR}"
	fi
	if which dbt-pgsql-generate-table-report > /dev/null 2>&1; then
		dbt-pgsql-generate-table-report -t "Database Test 7" \
				-i "${DBSTATDIR}/table-list.txt"
	fi
	if which dbt-pgsql-generate-index-report > /dev/null 2>&1; then
		dbt-pgsql-generate-index-report -t "Database Test 7" \
				-i "${DBSTATDIR}/index-list.txt"
	fi

	cat << __EOF__
$TITLE
--------------------------------------------------------------------------------

* \`Database Settings <${DIRECTORY}/dbstat/params.csv>\`__
* Per Process Statistics: $(list_processes)

.. list-table::

   * - Database Stats Charts
     - \`${DBT7DBNAME:-dbt7} <${DIRECTORY}/dbstat/db/${DBT7DBNAME:-dbt7}>\`__
   * - Database Table Stats Charts:
     - $(links_tables "${DIRECTORY}")
   * - Database Index Stats Charts:
     - $(links_indexes "${DIRECTORY}")
   * - Database Tables by Metric:
     - $(links_table_metrics "${DIRECTORY}")
   * - Database Indexs by Metric:
     - $(links_index_metrics "${DIRECTORY}")

__EOF__
}

show_images()
{
	PID=$1

	find "${PIDSTATDIR}" -type f -name "${PIDPREFIX}-${PID}-*.png" | \
			sort | while IFS= read -r CHART; do
		BCHART="$(basename "${CHART}")"
		echo ".. image:: ../../../pidstat/plots/${BCHART}"
		echo "   :target: ../../../pidstat/plots/${BCHART}"
		echo "   :width: 100%"
		echo ""
	done
}

PLOT_DBSTATS=1

# Custom argument handling for hopefully most portability.
while [ "${#}" -gt 0 ] ; do
	case "${1}" in
	(--skip-database-plotting)
		PLOT_DBSTATS=0
		;;
	(-i)
		shift
		INDIR="${1}"
		;;
	(-V | --version)
		echo "$(basename "${0}") (Database Test 7) v@PROJECT_VERSION@"
		exit 0
		;;
	(-\? | --help)
		usage
		exit 0
		;;
	(--* | -*)
		echo "$(basename "${0}"): invalid option -- '${1}'"
		echo "try \"$(basename "${0}") --help\" for more information."
		exit 1
		;;
	(*)
		break
		;;
	esac
	shift
done

if [ "${INDIR}" = "" ]; then
	echo "Specify dbt7 results directory with -i"
	exit 1
fi

# Set the spar vs pidstat image file name prefix here.
PIDPREFIX="spar"
# shellcheck disable=SC2044
for _ in $(find "${INDIR}" -type f -name pidstat.txt 2> /dev/null);
do
	PIDPREFIX="pidstat"
done

for TEST in load power throughput; do
	DBDIR="${INDIR}/${TEST}/dbstat"
	if [ ${PLOT_DBSTATS} -eq 1 ] && [ -d "${DBDIR}" ]; then
		ts plot-pgsql -d dbt7 -i "${DBDIR}" &
	fi
done
wait

cat << __EOF__
PostgreSQL Report
=================

$(summarize "Load Test" load)

$(summarize "Power Test" power)

$(summarize "Throughput Test" throughput)
__EOF__
