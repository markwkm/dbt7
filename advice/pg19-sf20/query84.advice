JOIN_ORDER(customer_address customer (income_band household_demographics) store_returns customer_demographics) NESTED_LOOP_PLAIN(customer household_demographics store_returns customer_demographics) HASH_JOIN((household_demographics income_band)) SEQ_SCAN(income_band) INDEX_SCAN(customer_address public.i_ca_city customer public.i_c_current_addr_sk household_demographics public.i_hd_income_band_sk) INDEX_ONLY_SCAN(store_returns public.i_sr_cdemo_sk customer_demographics public.pk_customer_demographics) NO_GATHER(customer customer_address customer_demographics household_demographics income_band store_returns)
