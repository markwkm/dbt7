JOIN_ORDER(store (d2 store_returns store_sales) d1) NESTED_LOOP_PLAIN(store_returns store_sales) NESTED_LOOP_MEMOIZE(d1) HASH_JOIN((store_sales store_returns d2)) INDEX_SCAN(store public.i_s_store_name d2 public.i_d_year store_returns public.i_sr_returned_date_sk store_sales public.pk_store_sales) INDEX_ONLY_SCAN(d1 public.pk_date_dim) NO_GATHER(store_sales store_returns store d1 d2)
