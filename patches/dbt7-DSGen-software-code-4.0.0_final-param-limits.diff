Raise parameter and command-line length limits and bound all copies.

PARAM_MAX_LEN grows from 80 to 4096 and RS_CMDLINARGS_LENGTH from 200
to 4096.  Every strcpy() into a parameter slot becomes a bounded
strncpy() with explicit NUL termination, and init_params() bounds its
default-value copy by the buffer size instead of a stale constant.

Previously an option value longer than 80 bytes overflowed its
malloc'd slot -- heap corruption; for example a long -dir path
clobbers the adjacent DISTRIBUTIONS parameter -- and command lines
over 200 bytes were truncated in the dbgen_version table.

Index: dbt7/dsgen/tools/r_params.c
===================================================================
--- dbt7.orig/dsgen/tools/r_params.c
+++ dbt7/dsgen/tools/r_params.c
@@ -46,7 +46,7 @@
 #include "tdefs.h"
 #include "release.h"
 
-#define PARAM_MAX_LEN	80
+#define PARAM_MAX_LEN	4096
 
 #ifndef TEST
 extern option_t options[];
@@ -131,7 +131,10 @@ set_flg(char *flag)
 	init_params();
 	nParam = fnd_param(flag);
 	if (nParam >= 0)
-		strcpy(params[options[nParam].index], "Y");
+	{
+		strncpy(params[options[nParam].index], "Y", PARAM_MAX_LEN - 1);
+		params[options[nParam].index][PARAM_MAX_LEN - 1] = '\0';
+	}
 
 	return;
 }
@@ -158,7 +161,10 @@ clr_flg(char *flag)
 	init_params();
 	nParam = fnd_param(flag);
 	if (nParam >= 0)
-		strcpy(params[options[nParam].index], "N");
+	{
+		strncpy(params[options[nParam].index], "N", PARAM_MAX_LEN - 1);
+		params[options[nParam].index][PARAM_MAX_LEN - 1] = '\0';
+	}
 	return;
 }
 
@@ -219,7 +225,8 @@ set_int(char *var, char *val)
 	nParam = fnd_param(var);
 	if (nParam >= 0)
 	{
-		strcpy(params[options[nParam].index], val);
+		strncpy(params[options[nParam].index], val, PARAM_MAX_LEN - 1);
+		params[options[nParam].index][PARAM_MAX_LEN - 1] = '\0';
 		options[nParam].flags |= OPT_SET;
 	}
 	return;
@@ -275,7 +282,8 @@ set_str(char *var, char *val)
 	nParam = fnd_param(var);
 	if (nParam >= 0)
 	{
-		strcpy(params[options[nParam].index], val);
+		strncpy(params[options[nParam].index], val, PARAM_MAX_LEN - 1);
+		params[options[nParam].index][PARAM_MAX_LEN - 1] = '\0';
 		options[nParam].flags |= OPT_SET;
 	}
 
@@ -338,7 +346,7 @@ init_params(void)
 	{
 		params[options[i].index] = (char *)malloc(PARAM_MAX_LEN * sizeof(char));
 		MALLOC_CHECK(params[options[i].index]);
-		strncpy(params[options[i].index], options[i].dflt, 80);
+		strncpy(params[options[i].index], options[i].dflt, PARAM_MAX_LEN - 1);
 		if (*options[i].dflt)
 			options[i].flags |= OPT_DFLT;
 	}
@@ -880,7 +888,10 @@ load_param(int nParam, char *szValue)
 	if (options[nParam].flags & OPT_SET)		/* already set from the command line */
 		return(0);
 	else
-		strcpy(params[options[nParam].index], szValue);
+	{
+		strncpy(params[options[nParam].index], szValue, PARAM_MAX_LEN - 1);
+		params[options[nParam].index][PARAM_MAX_LEN - 1] = '\0';
+	}
 
 	return(0);
 }
