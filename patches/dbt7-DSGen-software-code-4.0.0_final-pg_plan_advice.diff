+define YEAR=random(1998, 2002, uniform);
+define SELECTONE=text({"ss_sold_year",1},{"ss_item_sk",1},{"ss_customer_sk",1},{"ss_sold_year, ss_item_sk, ss_customer_sk",1});
+
+define _LIMIT = 100;
+
+RESET pg_plan_advice.advice; select set_config('pg_plan_advice.advice', 'JOIN_ORDER(date_dim@ws web_sales@ws web_returns@ws) JOIN_ORDER(date_dim@ss store_sales@ss store_returns@ss) JOIN_ORDER(date_dim@cs catalog_sales@cs catalog_returns@cs) JOIN_ORDER(ws (ss cs)) MERGE_JOIN_MATERIALIZE(cs (ss cs)) NESTED_LOOP_PLAIN(web_sales@ws web_returns@ws store_sales@ss catalog_sales@cs) HASH_JOIN(store_returns@ss catalog_returns@cs) SEQ_SCAN(date_dim@ws date_dim@ss date_dim@cs) INDEX_SCAN(web_sales@ws public.i_ws_sold_date_sk web_returns@ws public.i_wr_order_number store_sales@ss public.i_ss_sold_date_sk catalog_sales@cs public.i_cs_sold_date_sk) INDEX_ONLY_SCAN(store_returns@ss public.pk_store_returns catalog_returns@cs public.pk_catalog_returns) GATHER_MERGE((web_sales@ws web_returns@ws date_dim@ws) (store_sales@ss store_returns@ss date_dim@ss) (catalog_sales@cs catalog_returns@cs date_dim@cs)) NO_GATHER(ss ws cs)', false);
+with ws as
+  (select d_year AS ws_sold_year, ws_item_sk,
+    ws_bill_customer_sk ws_customer_sk,
+    sum(ws_quantity) ws_qty,
+    sum(ws_wholesale_cost) ws_wc,
+    sum(ws_sales_price) ws_sp
+   from web_sales
+   left join web_returns on wr_order_number=ws_order_number and ws_item_sk=wr_item_sk
+   join date_dim on ws_sold_date_sk = d_date_sk
+   where wr_order_number is null
+   group by d_year, ws_item_sk, ws_bill_customer_sk
+   ),
+cs as
+  (select d_year AS cs_sold_year, cs_item_sk,
+    cs_bill_customer_sk cs_customer_sk,
+    sum(cs_quantity) cs_qty,
+    sum(cs_wholesale_cost) cs_wc,
+    sum(cs_sales_price) cs_sp
+   from catalog_sales
+   left join catalog_returns on cr_order_number=cs_order_number and cs_item_sk=cr_item_sk
