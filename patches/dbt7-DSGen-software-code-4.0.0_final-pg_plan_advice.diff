+
+define YEAR=random(1998,2002,uniform);
+define SDATE=date([YEAR]+"-01-01",[YEAR]+"-07-01",sales);
+define CATEGORY=ulist(dist(categories,1,1),3);
+
+RESET pg_plan_advice.advice; select set_config('pg_plan_advice.advice', 'JOIN_ORDER(date_dim store_sales item) NESTED_LOOP_PLAIN(store_sales) HASH_JOIN(item) SEQ_SCAN(date_dim) BITMAP_HEAP_SCAN(item) INDEX_SCAN(store_sales public.i_ss_sold_date_sk) GATHER_MERGE((store_sales item date_dim))', false);
+select i_item_id
+      ,i_item_desc 
+      ,i_category 
+      ,i_class 
+      ,i_current_price
+      ,sum(ss_ext_sales_price) as itemrevenue 
+      ,sum(ss_ext_sales_price)*100/sum(sum(ss_ext_sales_price)) over
+          (partition by i_class) as revenueratio
+from	
+	store_sales
+    	,item 
+    	,date_dim
+where 
+	ss_item_sk = i_item_sk 
+  	and i_category in ('[CATEGORY.1]', '[CATEGORY.2]', '[CATEGORY.3]')
+  	and ss_sold_date_sk = d_date_sk
+	and d_date between cast('[SDATE]' as date) 
+				and (cast('[SDATE]' as date) + interval '30 days')
+group by 
+	i_item_id
+        ,i_item_desc 
+        ,i_category
+        ,i_class
+        ,i_current_price
+order by 
+	i_category
+        ,i_class
+        ,i_item_id
+        ,i_item_desc
+        ,revenueratio;
+
