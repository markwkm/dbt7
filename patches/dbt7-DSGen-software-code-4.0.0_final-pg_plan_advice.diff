+
+RESET pg_plan_advice.advice; select set_config('pg_plan_advice.advice', 'JOIN_ORDER(inv1 inv2) JOIN_ORDER(inventory@foo date_dim@foo item@foo warehouse@foo) HASH_JOIN(inv2 date_dim@foo item@foo warehouse@foo) SEQ_SCAN(inventory@foo warehouse@foo) INDEX_SCAN(date_dim@foo public.i_d_year) INDEX_ONLY_SCAN(item@foo public.pk_item) GATHER((inventory@foo item@foo warehouse@foo date_dim@foo)) NO_GATHER(inv1 inv2 foo@inv)', false);
+with inv as
+(select w_warehouse_name,w_warehouse_sk,i_item_sk,d_moy
+       ,stdev,mean, case mean when 0 then null else stdev/mean end cov
+ from(select w_warehouse_name,w_warehouse_sk,i_item_sk,d_moy
+            ,stddev_samp(inv_quantity_on_hand) stdev,avg(inv_quantity_on_hand) mean
+      from inventory
+          ,item
+          ,warehouse
+          ,date_dim
+      where inv_item_sk = i_item_sk
+        and inv_warehouse_sk = w_warehouse_sk
+        and inv_date_sk = d_date_sk
+        and d_year =[YEAR]
+      group by w_warehouse_name,w_warehouse_sk,i_item_sk,d_moy) foo
+ where case mean when 0 then 0 else stdev/mean end > 1)
+select inv1.w_warehouse_sk,inv1.i_item_sk,inv1.d_moy,inv1.mean, inv1.cov
+        ,inv2.w_warehouse_sk,inv2.i_item_sk,inv2.d_moy,inv2.mean, inv2.cov
