+define DMS = random(1176,1224,uniform);
+define _LIMIT=100;
+
+RESET pg_plan_advice.advice; select set_config('pg_plan_advice.advice', 'JOIN_ORDER(item@tmp1 store_sales@tmp1 date_dim@tmp1 store@tmp1) NESTED_LOOP_PLAIN(store_sales@tmp1) HASH_JOIN(date_dim@tmp1 store@tmp1) SEQ_SCAN(store@tmp1) BITMAP_HEAP_SCAN(item@tmp1) INDEX_SCAN(store_sales@tmp1 public.i_ss_item_sk date_dim@tmp1 public.i_d_month_seq) NO_GATHER(tmp1 item@tmp1 store_sales@tmp1 date_dim@tmp1 store@tmp1)', false);
+[_LIMITA] select [_LIMITB] * from 
+(select i_manufact_id,
+sum(ss_sales_price) sum_sales,
+avg(sum(ss_sales_price)) over (partition by i_manufact_id) avg_quarterly_sales
+from item, store_sales, date_dim, store
+where ss_item_sk = i_item_sk and
+ss_sold_date_sk = d_date_sk and
+ss_store_sk = s_store_sk and
+d_month_seq in ([DMS],[DMS]+1,[DMS]+2,[DMS]+3,[DMS]+4,[DMS]+5,[DMS]+6,[DMS]+7,[DMS]+8,[DMS]+9,[DMS]+10,[DMS]+11) and
+((i_category in ('Books','Children','Electronics') and
+i_class in ('personal','portable','reference','self-help') and
+i_brand in ('scholaramalgamalg #14','scholaramalgamalg #7',
+		'exportiunivamalg #9','scholaramalgamalg #9'))
+or(i_category in ('Women','Music','Men') and
+i_class in ('accessories','classical','fragrances','pants') and
+i_brand in ('amalgimporto #1','edu packscholar #1','exportiimporto #1',
+		'importoamalg #1')))
