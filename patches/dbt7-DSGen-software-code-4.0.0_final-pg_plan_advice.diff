+RESET pg_plan_advice.advice; select set_config('pg_plan_advice.advice', 'JOIN_ORDER(date_dim@dn store_sales@dn household_demographics@dn customer_address@dn store@dn) JOIN_ORDER(dn customer current_addr) NESTED_LOOP_PLAIN(store_sales@dn customer current_addr) HASH_JOIN(household_demographics@dn customer_address@dn store@dn) SEQ_SCAN(date_dim@dn household_demographics@dn customer_address@dn store@dn) INDEX_SCAN(store_sales@dn public.i_ss_sold_date_sk customer public.pk_customer current_addr public.pk_customer_address) GATHER((store_sales@dn date_dim@dn household_demographics@dn customer_address@dn)) NO_GATHER(dn customer current_addr store@dn)', false);
