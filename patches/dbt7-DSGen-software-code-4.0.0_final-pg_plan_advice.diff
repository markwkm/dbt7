+ define VEHCNT=random(-1,4,uniform);
+ define CITYNUMBER = ulist(random(1, rowcount("active_cities", "store"), uniform), 2);
+ define CITY_A = distmember(cities, [CITYNUMBER.1], 1);
+ define CITY_B = distmember(cities, [CITYNUMBER.2], 1);
