+RESET pg_plan_advice.advice; select set_config('pg_plan_advice.advice', 'JOIN_ORDER(date_dim#3@sr_items date_dim#2@sr_items date_dim@sr_items store_returns@sr_items item@sr_items) JOIN_ORDER(date_dim#3@cr_items date_dim#2@cr_items date_dim@cr_items catalog_returns@cr_items item@cr_items) JOIN_ORDER(date_dim#3@wr_items date_dim#2@wr_items date_dim@wr_items web_returns@wr_items item@wr_items) JOIN_ORDER(sr_items cr_items wr_items) NESTED_LOOP_PLAIN(date_dim#2@sr_items date_dim@sr_items store_returns@sr_items date_dim@cr_items catalog_returns@cr_items date_dim#2@wr_items date_dim@wr_items web_returns@wr_items item@wr_items) NESTED_LOOP_MEMOIZE(date_dim#2@cr_items) HASH_JOIN(item@sr_items item@cr_items cr_items wr_items) SEQ_SCAN(item@sr_items item@cr_items) INDEX_SCAN(date_dim#3@sr_items public.i_d_date date_dim#2@sr_items public.i_d_week_seq date_dim@sr_items public.i_d_date store_returns@sr_items public.i_sr_returned_date_sk date_dim#3@cr_items public.i_d_date date_dim#2@cr_items public.i_d_week_seq date_dim@cr_items public.i_d_date catalog_returns@cr_items public.i_cr_returned_date_sk date_dim#3@wr_items public.i_d_date date_dim#2@wr_items public.i_d_week_seq date_dim@wr_items public.i_d_date web_returns@wr_items public.i_wr_returned_date_sk item@wr_items public.pk_item) SEMIJOIN_UNIQUE((date_dim#2@sr_items date_dim#3@sr_items) date_dim#3@sr_items (date_dim#2@cr_items date_dim#3@cr_items) date_dim#3@cr_items (date_dim#2@wr_items date_dim#3@wr_items) date_dim#3@wr_items) NO_GATHER(sr_items cr_items wr_items store_returns@sr_items item@sr_items date_dim@sr_items date_dim#2@sr_items date_dim#3@sr_items catalog_returns@cr_items item@cr_items date_dim@cr_items date_dim#2@cr_items date_dim#3@cr_items web_returns@wr_items item@wr_items date_dim@wr_items date_dim#2@wr_items date_dim#3@wr_items)', false);
+ with sr_items as
+ (select i_item_id item_id,
+        sum(sr_return_quantity) sr_item_qty
+ from store_returns,
+      item,
+      date_dim
+ where sr_item_sk = i_item_sk
+ and   d_date    in 
+	(select d_date
+	from date_dim
+	where d_week_seq in 
+		(select d_week_seq
+		from date_dim
+	  where d_date in ('[RETURNED_DATE_ONE]','[RETURNED_DATE_TWO]','[RETURNED_DATE_THREE]')))
+ and   sr_returned_date_sk   = d_date_sk
+ group by i_item_id),
+ cr_items as
+ (select i_item_id item_id,
+        sum(cr_return_quantity) cr_item_qty
+ from catalog_returns,
+      item,
+      date_dim
+ where cr_item_sk = i_item_sk
+ and   d_date    in 
+	(select d_date
+	from date_dim
+	where d_week_seq in 
+		(select d_week_seq
+		from date_dim
+	  where d_date in ('[RETURNED_DATE_ONE]','[RETURNED_DATE_TWO]','[RETURNED_DATE_THREE]')))
+ and   cr_returned_date_sk   = d_date_sk
+ group by i_item_id),
+ wr_items as
+ (select i_item_id item_id,
+        sum(wr_return_quantity) wr_item_qty
+ from web_returns,
+      item,
+      date_dim
+ where wr_item_sk = i_item_sk
+ and   d_date    in 
+	(select d_date
+	from date_dim
+	where d_week_seq in 
+		(select d_week_seq
+		from date_dim
+		where d_date in ('[RETURNED_DATE_ONE]','[RETURNED_DATE_TWO]','[RETURNED_DATE_THREE]')))
+ and   wr_returned_date_sk   = d_date_sk
+ group by i_item_id)
+ [_LIMITA] select [_LIMITB] sr_items.item_id
+       ,sr_item_qty
+       ,sr_item_qty/(sr_item_qty+cr_item_qty+wr_item_qty)/3.0 * 100 sr_dev
+       ,cr_item_qty
+       ,cr_item_qty/(sr_item_qty+cr_item_qty+wr_item_qty)/3.0 * 100 cr_dev
+       ,wr_item_qty
+       ,wr_item_qty/(sr_item_qty+cr_item_qty+wr_item_qty)/3.0 * 100 wr_dev
