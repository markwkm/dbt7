+RESET pg_plan_advice.advice; select set_config('pg_plan_advice.advice', 'JOIN_ORDER(date_dim catalog_sales item) JOIN_ORDER(catalog_sales@expr_1 date_dim@expr_1) MERGE_JOIN_MATERIALIZE(item) NESTED_LOOP_PLAIN(catalog_sales) HASH_JOIN(date_dim@expr_1) SEQ_SCAN(date_dim) BITMAP_HEAP_SCAN(date_dim@expr_1) INDEX_SCAN(catalog_sales public.i_cs_sold_date_sk item public.i_i_manufact_id catalog_sales@expr_1 public.i_cs_item_sk) GATHER((catalog_sales date_dim)) NO_GATHER(item catalog_sales@expr_1 date_dim@expr_1)', false);
