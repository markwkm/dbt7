+ define MS= ulist(dist(marital_status, 1, 1), 3);
+ define ES= ulist(dist(education, 1, 1), 3);
+ define STATE= ulist(dist(fips_county, 3, 1), 9);
+ 
+
+RESET pg_plan_advice.advice; select set_config('pg_plan_advice.advice', 'JOIN_ORDER(date_dim store_sales household_demographics customer_address customer_demographics store) MERGE_JOIN_PLAIN(customer_address store) NESTED_LOOP_PLAIN(store_sales customer_demographics) HASH_JOIN(household_demographics) SEQ_SCAN(date_dim store) BITMAP_HEAP_SCAN(household_demographics customer_address) INDEX_SCAN(store_sales public.i_ss_sold_date_sk customer_demographics public.pk_customer_demographics) GATHER((store_sales customer_demographics household_demographics customer_address date_dim)) NO_GATHER(store)', false);
+ select avg(ss_quantity)
+       ,avg(ss_ext_sales_price)
+       ,avg(ss_ext_wholesale_cost)
+       ,sum(ss_ext_wholesale_cost)
+ from store_sales
+     ,store
+     ,customer_demographics
+     ,household_demographics
+     ,customer_address
+     ,date_dim
+ where s_store_sk = ss_store_sk
+ and  ss_sold_date_sk = d_date_sk and d_year = 2001
+ and((ss_hdemo_sk=hd_demo_sk
+  and cd_demo_sk = ss_cdemo_sk
+  and cd_marital_status = '[MS.1]'
+  and cd_education_status = '[ES.1]'
+  and ss_sales_price between 100.00 and 150.00
+  and hd_dep_count = 3   
+     )or
+     (ss_hdemo_sk=hd_demo_sk
+  and cd_demo_sk = ss_cdemo_sk
+  and cd_marital_status = '[MS.2]'
+  and cd_education_status = '[ES.2]'
+  and ss_sales_price between 50.00 and 100.00   
+  and hd_dep_count = 1
+     ) or 
+     (ss_hdemo_sk=hd_demo_sk
+  and cd_demo_sk = ss_cdemo_sk
+  and cd_marital_status = '[MS.3]'
+  and cd_education_status = '[ES.3]'
+  and ss_sales_price between 150.00 and 200.00 
+  and hd_dep_count = 1  
