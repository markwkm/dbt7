+RESET pg_plan_advice.advice; select set_config('pg_plan_advice.advice', 'JOIN_ORDER(date_dim catalog_sales item catalog_returns warehouse) NESTED_LOOP_PLAIN(catalog_sales catalog_returns) NESTED_LOOP_MATERIALIZE(warehouse) HASH_JOIN(item) INDEX_SCAN(date_dim public.i_d_date catalog_sales public.i_cs_sold_date_sk item public.i_i_current_price catalog_returns public.i_cr_order_number warehouse public.i_w_state) NO_GATHER(catalog_sales catalog_returns warehouse item date_dim)', false);
