+RESET pg_plan_advice.advice; select set_config('pg_plan_advice.advice', 'JOIN_ORDER(web_page@at web_sales@at time_dim@at household_demographics@at) JOIN_ORDER(web_page@pt web_sales@pt time_dim@pt household_demographics@pt) JOIN_ORDER(at pt) NESTED_LOOP_PLAIN(web_sales@at web_sales@pt pt) HASH_JOIN(time_dim@at household_demographics@at time_dim@pt household_demographics@pt) SEQ_SCAN(web_page@at web_page@pt) INDEX_SCAN(web_sales@at public.i_ws_web_page_sk time_dim@at public.i_t_hour household_demographics@at public.i_hd_dep_count web_sales@pt public.i_ws_web_page_sk time_dim@pt public.i_t_hour household_demographics@pt public.i_hd_dep_count) NO_GATHER(at pt web_sales@at household_demographics@at time_dim@at web_page@at web_sales@pt household_demographics@pt time_dim@pt web_page@pt)', false);
