+RESET pg_plan_advice.advice; select set_config('pg_plan_advice.advice', 'JOIN_ORDER(d1@results web_sales@results item@results) MERGE_JOIN_PLAIN(item@results) NESTED_LOOP_PLAIN(web_sales@results) SEQ_SCAN(d1@results item@results) INDEX_SCAN(web_sales@results public.i_ws_sold_date_sk) GATHER_MERGE((web_sales@results d1@results item@results)) NO_GATHER(results_rollup unnamed_subquery@results_rollup unnamed_subquery#2@results_rollup unnamed_subquery#3@results_rollup results@setop_1 results@setop_2 results@setop_3)', false);
+ with results as
