+RESET pg_plan_advice.advice; select set_config('pg_plan_advice.advice', 'JOIN_ORDER(item@my_customers cs_or_ws_sales@my_customers date_dim@my_customers customer@my_customers) JOIN_ORDER(my_customers@my_revenue customer_address@my_revenue store@my_revenue store_sales@my_revenue date_dim@my_revenue) NESTED_LOOP_PLAIN(cs_or_ws_sales@my_customers customer@my_customers customer_address@my_revenue store@my_revenue store_sales@my_revenue date_dim@my_revenue) HASH_JOIN(date_dim@my_customers) BITMAP_HEAP_SCAN(item@my_customers) INDEX_SCAN(catalog_sales@my_customers public.i_cs_item_sk web_sales@my_customers public.i_ws_item_sk date_dim@my_customers public.i_d_year customer@my_customers public.pk_customer customer_address@my_revenue public.pk_customer_address store@my_revenue public.i_s_state store_sales@my_revenue public.i_ss_customer_sk date_dim@my_revenue public.pk_date_dim date_dim@expr_1 public.i_d_year date_dim@expr_2 public.i_d_year) NO_GATHER(my_revenue my_customers@my_revenue store_sales@my_revenue customer_address@my_revenue store@my_revenue date_dim@my_revenue item@my_customers date_dim@my_customers customer@my_customers catalog_sales@my_customers web_sales@my_customers date_dim@expr_1 date_dim@expr_2)', false);
+ with my_customers as (
+ select distinct c_customer_sk
+        , c_current_addr_sk
+ from   
+        ( select cs_sold_date_sk sold_date_sk,
+                 cs_bill_customer_sk customer_sk,
+                 cs_item_sk item_sk
+          from   catalog_sales
+          union all
+          select ws_sold_date_sk sold_date_sk,
+                 ws_bill_customer_sk customer_sk,
+                 ws_item_sk item_sk
+          from   web_sales
+         ) cs_or_ws_sales,
+         item,
+         date_dim,
+         customer
+ where   sold_date_sk = d_date_sk
+         and item_sk = i_item_sk
+         and i_category = '[CATEGORY]'
+         and i_class = '[CLASS]'
+         and c_customer_sk = cs_or_ws_sales.customer_sk
+         and d_moy = [MONTH]
+         and d_year = [YEAR]
+ )
+ , my_revenue as (
+ select c_customer_sk,
+        sum(ss_ext_sales_price) as revenue
+ from   my_customers,
+        store_sales,
+        customer_address,
+        store,
+        date_dim
+ where  c_current_addr_sk = ca_address_sk
+        and ca_county = s_county
+        and ca_state = s_state
+        and ss_sold_date_sk = d_date_sk
+        and c_customer_sk = ss_customer_sk
+        and d_month_seq between (select distinct d_month_seq+1
+                                 from   date_dim where d_year = [YEAR] and d_moy = [MONTH])
+                           and  (select distinct d_month_seq+3
+                                 from   date_dim where d_year = [YEAR] and d_moy = [MONTH])
+ group by c_customer_sk
+ )
+ , segments as
+ (select cast((revenue/50) as int) as segment
+  from   my_revenue
+ )
+ [_LIMITA] select [_LIMITB] segment, count(*) as num_customers, segment*50 as segment_base
+ from segments
+ group by segment
+ order by segment, num_customers
+ [_LIMITC];
