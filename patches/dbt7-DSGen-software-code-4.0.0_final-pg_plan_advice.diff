+define _LIMIT=100;
+
+RESET pg_plan_advice.advice; select set_config('pg_plan_advice.advice', 'JOIN_ORDER(date_dim@promotional_sales store_sales@promotional_sales store@promotional_sales item@promotional_sales customer@promotional_sales customer_address@promotional_sales promotion@promotional_sales) JOIN_ORDER(date_dim@all_sales store_sales@all_sales store@all_sales item@all_sales customer@all_sales customer_address@all_sales) JOIN_ORDER(promotional_sales all_sales) NESTED_LOOP_PLAIN(store_sales@promotional_sales item@promotional_sales customer@promotional_sales customer_address@promotional_sales store_sales@all_sales item@all_sales customer@all_sales customer_address@all_sales all_sales) NESTED_LOOP_MATERIALIZE(promotion@promotional_sales) HASH_JOIN(store@promotional_sales store@all_sales) SEQ_SCAN(promotion@promotional_sales) INDEX_SCAN(date_dim@promotional_sales public.i_d_year store_sales@promotional_sales public.i_ss_sold_date_sk store@promotional_sales public.i_s_gmt_offset item@promotional_sales public.pk_item customer@promotional_sales public.pk_customer customer_address@promotional_sales public.pk_customer_address date_dim@all_sales public.i_d_year store_sales@all_sales public.i_ss_sold_date_sk store@all_sales public.i_s_gmt_offset item@all_sales public.pk_item customer@all_sales public.pk_customer customer_address@all_sales public.pk_customer_address) NO_GATHER(promotional_sales all_sales store_sales@promotional_sales store@promotional_sales promotion@promotional_sales date_dim@promotional_sales customer@promotional_sales customer_address@promotional_sales item@promotional_sales store_sales@all_sales store@all_sales date_dim@all_sales customer@all_sales customer_address@all_sales item@all_sales)', false);
+[_LIMITA] select [_LIMITB] promotions,total,cast(promotions as decimal(15,4))/cast(total as decimal(15,4))*100
+from
+  (select sum(ss_ext_sales_price) promotions
