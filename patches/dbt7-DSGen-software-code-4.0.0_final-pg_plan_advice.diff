+RESET pg_plan_advice.advice; select set_config('pg_plan_advice.advice', 'JOIN_ORDER(date_dim@ms store_sales@ms household_demographics@ms store@ms) JOIN_ORDER(customer ms) MERGE_JOIN_PLAIN(ms) NESTED_LOOP_PLAIN(store_sales@ms) HASH_JOIN(household_demographics@ms store@ms) SEQ_SCAN(date_dim@ms household_demographics@ms store@ms) INDEX_SCAN(store_sales@ms public.i_ss_sold_date_sk customer public.pk_customer) GATHER_MERGE((store_sales@ms date_dim@ms store@ms household_demographics@ms)) NO_GATHER(ms customer)', false);
