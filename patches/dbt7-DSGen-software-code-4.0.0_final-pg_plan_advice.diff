+ define MS= ulist(dist(marital_status, 1, 1), 3);
+ define ES= ulist(dist(education, 1, 1), 3);
+ define STATE= ulist(dist(fips_county, 3, 1), 9);
+ define YEAR= random(1998,2002, uniform);
+
+RESET pg_plan_advice.advice; select set_config('pg_plan_advice.advice', 'JOIN_ORDER(date_dim store_sales customer_address customer_demographics store) NESTED_LOOP_PLAIN(store_sales) NESTED_LOOP_MEMOIZE(store) HASH_JOIN(customer_address customer_demographics) SEQ_SCAN(date_dim) BITMAP_HEAP_SCAN(customer_demographics) INDEX_SCAN(store_sales public.i_ss_sold_date_sk customer_address public.i_ca_country) INDEX_ONLY_SCAN(store public.pk_store) GATHER((store_sales customer_demographics customer_address date_dim)) NO_GATHER(store)', false);
+ select sum (ss_quantity)
+ from store_sales, store, customer_demographics, customer_address, date_dim
+ where s_store_sk = ss_store_sk
+ and  ss_sold_date_sk = d_date_sk and d_year = [YEAR]
+ and  
+ (
