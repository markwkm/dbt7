+ define GMT = dist(fips_county, 6, 1);
+ define COLOR=ulist(dist(colors,1,1),3);
+ define _LIMIT=100;
+
+RESET pg_plan_advice.advice; select set_config('pg_plan_advice.advice', 'JOIN_ORDER(item@ss item#2@ss store_sales@ss date_dim@ss customer_address@ss) JOIN_ORDER(date_dim@cs catalog_sales@cs customer_address@cs item@cs item#2@cs) JOIN_ORDER(item#2@ws item@ws web_sales@ws date_dim@ws customer_address@ws) NESTED_LOOP_PLAIN(store_sales@ss customer_address@ss catalog_sales@cs item@cs item@ws web_sales@ws customer_address@ws) NESTED_LOOP_MEMOIZE(customer_address@cs) HASH_JOIN(item#2@ss date_dim@ss item#2@cs date_dim@ws) SEQ_SCAN(item@ss) INDEX_SCAN(item#2@ss public.i_i_color store_sales@ss public.i_ss_item_sk date_dim@ss public.i_d_year customer_address@ss public.pk_customer_address date_dim@cs public.i_d_year catalog_sales@cs public.i_cs_sold_date_sk customer_address@cs public.pk_customer_address item@cs public.pk_item item#2@cs public.i_i_color item#2@ws public.i_i_color item@ws public.i_i_item_id web_sales@ws public.i_ws_item_sk date_dim@ws public.i_d_year customer_address@ws public.pk_customer_address) GATHER((store_sales@ss date_dim@ss customer_address@ss item@ss item#2@ss)) SEMIJOIN_NON_UNIQUE(item#2@ss item#2@cs) SEMIJOIN_UNIQUE(item#2@ws) NO_GATHER(ss cs ws catalog_sales@cs date_dim@cs customer_address@cs item@cs item#2@cs web_sales@ws date_dim@ws customer_address@ws item@ws item#2@ws)', false);
+ with ss as (
+ select i_item_id,sum(ss_ext_sales_price) total_sales
+ from
