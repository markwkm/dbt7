+   cd_demo_sk = ss_cdemo_sk
+   and 
+   cd_marital_status = '[MS.1]'
+   and 
+   cd_education_status = '[ES.1]'
+   and 
+   ss_sales_price between 100.00 and 150.00  
+   )
+ or
