+RESET pg_plan_advice.advice; select set_config('pg_plan_advice.advice', 'JOIN_ORDER(web_returns customer_address cd1 reason web_sales cd2 web_page date_dim) MERGE_JOIN_PLAIN(reason) NESTED_LOOP_PLAIN(web_sales cd2 web_page date_dim) HASH_JOIN(customer_address cd1) SEQ_SCAN(web_returns reason web_page) BITMAP_HEAP_SCAN(customer_address cd1) INDEX_SCAN(web_sales public.pk_web_sales cd2 public.pk_customer_demographics date_dim public.pk_date_dim) GATHER((web_sales web_returns cd1 cd2 customer_address reason)) NO_GATHER(web_page date_dim)', false);
+ [_LIMITA] select [_LIMITB] substr(r_reason_desc,1,20)
+       ,avg(ws_quantity)
+       ,avg(wr_refunded_cash)
+       ,avg(wr_fee)
+ from web_sales, web_returns, web_page, customer_demographics cd1,
+      customer_demographics cd2, customer_address, date_dim, reason 
